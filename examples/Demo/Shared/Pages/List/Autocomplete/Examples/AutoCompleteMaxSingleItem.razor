@inject DataSource Data

<FluentAutocomplete TOption="Country"
                    AutoComplete="off"
                    Label="Select a country"
                    Width="250px"
                    Placeholder="Select a country"
                    OnOptionsSearch="@OnSearchAsync"
                    OptionDisabled="@(e => e.Code == "au")"
                    Multiple=false
                    OptionText="@(item => item.Name)"
                    @bind-SelectedOption=SelectedItem />

<p>
    <b>Selected</b>: @(SelectedItem?.Name)
</p>

<FluentButton OnClick="SetSelectedItem">Set Zambia</FluentButton>

@code
{
    Country? SelectedItem = null;
    IEnumerable<Country>? AllItems = null;

    protected override async Task OnInitializedAsync()
    {
        AllItems = await Data.GetCountriesAsync();
        await base.OnInitializedAsync();
    }

    private void OnSearchAsync(OptionsSearchEventArgs<Country> e)
    {
        e.Items = AllItems?.Where(i => i.Name.StartsWith(e.Text, StringComparison.OrdinalIgnoreCase))
                              .OrderBy(i => i.Name);
    }

    void SetSelectedItem()
    {
        SelectedItem = AllItems?.Last();
        StateHasChanged();
    }
